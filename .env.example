# ==============================================================================
# ENVIRONMENT & NETWORK
# ==============================================================================
# Development-only examples. Copy to .env locally; never use these credentials in production.
APP_ENV=development
WEB_PORT=5173

# Internal service ports are fixed in Compose; override host ports instead.
API_PORT=8080
API_HOST_PORT=8080
AI_PORT=8001

# Web Server & Proxy
CADDY_HTTP_PORT=80
CADDY_BIND_ADDRESS=0.0.0.0
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173

# Optional: set only to the IP/CIDR of an explicitly trusted ingress proxy; leave blank otherwise.
TRUSTED_PROXY_CIDRS=

# ==============================================================================
# DATABASE (POSTGRES)
# ==============================================================================
POSTGRES_DB=floodwatch
POSTGRES_USER=floodwatch
POSTGRES_PASSWORD=local-only-change-me
# Percent-encode special characters in the password when composing DATABASE_URL.
DATABASE_URL=postgres://floodwatch:local-only-change-me@postgres:5432/floodwatch?sslmode=disable

# ==============================================================================
# CACHE & STORAGE (REDIS & MINIO)
# ==============================================================================
REDIS_URL=redis://redis:6379/0

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=local-minio-user
MINIO_SECRET_KEY=local-only-change-me
MINIO_BUCKET=floodwatch-dev

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=dev-only-change-me-to-a-long-random-value-before-exposing-service
COOKIE_NAME=fw_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
# For a callback on API port 8080 and frontend on port 5173, use that callback URL
# and set CORS_ALLOWED_ORIGINS to only http://localhost:5173 (Caddy must serve that port).

# Admin bootstrap is manual only. Set these in your shell for the one-off command; do not save them in .env.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# ==============================================================================
# EMAIL NOTIFICATIONS (SMTP)
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# ==============================================================================
# PUSH NOTIFICATIONS (VAPID)
# ==============================================================================
# Optional locally: leave all three unset to disable Web Push. Required in production.
# Generate a key pair with `npx web-push generate-vapid-keys` and keep the private key in .env only.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBSCRIBER=mailto:admin@example.com

# ==============================================================================
# APP FEATURES & INTEGRATIONS
# ==============================================================================
SWAGGER_ENABLED=true
WEATHER_ENABLED=true
# Optional: add FM91_NEWS after migration 28 to auto-publish matching FM91 news every five minutes.
# Keep the same provider allowlist in API and worker; append to existing codes rather than replace them.
EXTERNAL_DATA_PROVIDERS=
EXTERNAL_DATA_OPENMETEO_NONCOMMERCIAL=false
AI_SERVICE_URL=http://ai-python:8001

# Optional development/test-only synthetic fixture. Leave both unset by default;
# the source must already exist as an enabled COMMUNITY `SYNTH_*` data source.
# INGESTION_FIXTURE_URL=http://host.docker.internal:8090
# INGESTION_FIXTURE_SOURCE_CODE=SYNTH_FIXTURE
