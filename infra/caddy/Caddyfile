{
    log default {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete code
                    delete state
                    delete error_description
                }
                request>headers>Cookie delete
                request>headers>Authorization delete
                request>headers>X-Report-Upload-Token delete
                resp_headers>Set-Cookie delete
            }
        }
    }
}

